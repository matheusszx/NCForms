# Copie para .env e ajuste os valores antes de subir com docker compose.

# Senha do banco PostgreSQL
DB_PASSWORD=troque-esta-senha

# Segredo para assinar os tokens de login (mínimo 32 caracteres).
# Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres

# Duração da sessão (formato ISO-8601: PT8H = 8 horas)
JWT_EXPIRATION=PT8H

# Permite criar novas contas. Após criar as contas necessárias, mude para false.
APP_REGISTRATION_ENABLED=true

# Porta HTTP em que o app ficará disponível no servidor
APP_PORT=80

# Porta local do Postgres (exposta apenas em 127.0.0.1)
DB_PORT=5432
