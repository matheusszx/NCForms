# Copy to .env and adjust the values before starting with docker compose.

# PostgreSQL database password
DB_PASSWORD=change-this-password

# Secret used to sign login tokens (at least 32 characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-32+-characters

# Session duration (ISO-8601 format: PT8H = 8 hours)
JWT_EXPIRATION=PT8H

# Allows new accounts to be created. After creating the accounts you need, set it to false.
APP_REGISTRATION_ENABLED=true

# HTTP port the app is published on (plain setup without docker-compose.prod.yml)
APP_PORT=80

# Local Postgres port (exposed on 127.0.0.1 only)
DB_PORT=5432

# Public domain for the HTTPS setup (docker-compose.prod.yml + Caddy).
# Point a DNS A record for it to the server's IP before starting.
APP_DOMAIN=forms.example.com
